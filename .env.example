# Copy this file to .env and fill in the two keys. Never commit .env.

# --- LLM (Groq free tier) --- https://console.groq.com/keys
GROQ_API_KEY=gsk_...
PROVIDER=groq
# openai/gpt-oss-120b is best at tool calling on Groq's free tier.
# Switch to openai/gpt-oss-20b if you hit daily token caps.
MODEL=openai/gpt-oss-120b

# --- LangSmith (free Developer plan) --- https://smith.langchain.com -> Settings -> API Keys
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=langchain-stack-course
# EU accounts only: LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# --- Optional alternatives ---
# GOOGLE_API_KEY=...        (PROVIDER=gemini, MODEL=gemini-2.5-flash)
# PROVIDER=ollama           (MODEL=qwen3:8b, needs `ollama pull qwen3:8b`)
