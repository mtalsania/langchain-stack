# Copy to .env and fill in. Never commit .env.

# --- SEC (required) --- name + email, as the SEC requires on every request
SEC_USER_AGENT="Your Name your.email@example.com"

# --- LLM: Groq free tier (primary) --- https://console.groq.com/keys
GROQ_API_KEY=gsk_...
PROVIDER=groq
MODEL=openai/gpt-oss-120b
SMALL_MODEL=openai/gpt-oss-20b

# --- LLM: Gemini API free tier (fallback, from M3) --- https://aistudio.google.com/apikey
# GOOGLE_API_KEY=...

# --- LangSmith free Developer plan ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=watchlist-agent
